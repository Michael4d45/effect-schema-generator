{
    "name": "michael4d45/effect-schema-generator",
    "description": "PHP attributes and Artisan wrapper for the Rust effect-schema binary",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Michael",
            "email": "michael4d45@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "EffectSchemaGenerator\\": "src/"
        }
    },
    "extra": {
