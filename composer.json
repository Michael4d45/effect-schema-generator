{
    "name": "michael4d45/effect-schema-generator",
    "description": "PHP attributes and Artisan wrapper for the Rust effect-schema binary",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "typescript",
        "effect-ts",
        "schema-generator",
        "spatie-data"
    ],
    "authors": [
        {
            "name": "Michael",
            "email": "michael4d45@gmail.com"
        }
    ],
    "homepage": "https://github.com/Michael4d45/effect-schema-generator",
    "support": {
        "issues": "https://github.com/Michael4d45/effect-schema-generator/issues",
        "source": "https://github.com/Michael4d45/effect-schema-generator"
    },
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "EffectSchemaGenerator\\": "php/src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EffectSchemaGenerator\\EffectSchemaGeneratorServiceProvider"
            ]
        }
    },
    "archive": {
        "exclude": [
            "/src",
            "/tests",
            "/js",
            "/scripts",
            "/target",
            "/.github",
            "/Cargo.toml",
            "/Cargo.lock"
        ]
    }
}
